NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Management token is used only by the local migration/verification scripts.
SUPABASE_ACCESS_TOKEN=
# 32 random bytes encoded as base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PROVIDER_ENCRYPTION_KEY=
APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_PLATFORM_NAME=Voixel
# demo displays tagged synthetic records and disables external provider actions; live selects real records.
DATA_MODE=live
# Optional local onboarding source; the application reads encrypted credentials from Supabase.
TELTEL_API_KEY=
TELTEL_ACCOUNT_CURRENCY=EUR
TELTEL_PROVIDER_ACCOUNT_ID=
# Bootstrap reads these locally; never commit them. Omit password to send an invitation.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
# Optional explicit demo Super Admin provisioning. Never exposed to the browser.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
# Dedicated worker, not a Vercel function
WORKER_POLL_MS=5000
WORKER_SYNC_INTERVAL_SECONDS=300
LOG_LEVEL=info
# Auth email delivery; configure Supabase with npm run configure:auth.
# These values are server secrets and must never use a NEXT_PUBLIC_ prefix.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Voixel"
SMTP_RATE_LIMIT_PER_HOUR=100
